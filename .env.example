# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Prototype: a SQLite file inside the repo. No server, no Docker.
DATABASE_PATH="./data/lexhall.db"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
AUTH_SECRET="dev-only-change-me-in-production-min-32-chars"

# ---------------------------------------------------------------------------
# Feature flags. Every flag below is OFF until the corresponding legal
# clearance in docs/COMPLIANCE_MATRIX.md is signed off. Do not flip these
# in production without a recorded decision in docs/DECISIONS.md.
# ---------------------------------------------------------------------------
FEATURE_REVIEWS="false"                 # BCI Rule 36 + defamation + DPDP review required
FEATURE_ANONYMOUS_REVIEWS="false"       # Higher risk than attributed reviews
FEATURE_PAYMENTS="false"                # Fee-sharing / commission analysis required
FEATURE_PAID_RANKING="false"            # Intentionally never enabled: see DECISIONS.md ADR-009
FEATURE_REFERRALS="false"               # Referral fee prohibition analysis required
FEATURE_CONTRACT_SAAS="false"           # Phase 3
FEATURE_MEDIATION="false"               # Phase 3
FEATURE_ARBITRATION="false"             # Phase 3
FEATURE_AI_INTAKE="true"                # Deterministic classifier only, no LLM advice
FEATURE_INGEST_LIVE="true"              # Live crawl of permitted public sources

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
INGEST_USER_AGENT="LexhallBot/0.1 (+http://localhost:3000/bot; data-correction@lexhall.example)"
INGEST_RATE_LIMIT_MS="2000"             # Minimum delay between requests to one host
INGEST_MAX_CONCURRENCY="1"              # Per-host concurrency. Keep at 1: be a good citizen.
